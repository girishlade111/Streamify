                             <div class="aspect-video bg-gray-300 rounded-lg mb-2 overflow-hidden">
                                <img src="https://placehold.co/600x400/2C2C2C/white?text=Stream+3" alt="Stream Thumbnail" class="w-full h-full object-cover group-hover:scale-105 transition-transform"/>
