                    <div class="p-2 border-t border-[var(--border-color)]">
                        <input type="text" placeholder="Send a message (disabled)" class="w-full p-2 text-sm border rounded-md bg-gray-200" disabled />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // --- DATA FOR DYNAMIC CONTENT ---
            const archData = {
                'arch-vanilla': {
                    title: 'Vanilla First',
                    content: 'No frameworks (like React, Vue, or Angular) were used. This focuses on core web technologies and performance, resulting in a very small bundle size and fast load times.'
                },
                'arch-modular': {
                    title: 'Modular JavaScript',
                    content: "The code is organized into ES6 modules to promote separation of concerns. For example, DOM manipulation is separate from API logic, making the codebase cleaner and easier to maintain."
                },
                'arch-state': {
                    title: 'Simple State Management',
                    content: "Global state is managed in simple JavaScript objects. This approach is sufficient and lightweight for the project's scope, avoiding unnecessary complexity."
                },
                'arch-css': {
                    title: 'Modern CSS',
                    content: 'A comprehensive set of CSS variables (design tokens) are used for easy theming and maintaining a consistent design system, combined with Tailwind for layout.'
                },
                'arch-data': {
                    title: 'Data-Driven UI',
                    content: 'The user interface is rendered dynamically from a mock `data.json` file. This simulates fetching data from a real API and makes it easy to add or change content without touching the HTML markup.'
                }
            };

            const setupData = {
                'setup-mock': `
                    <h4 class="font-bold text-lg mb-4">Mode 1: Mock Mode (No Server Needed)</h4>
                    <p class="text-[var(--text-secondary)] mb-4">This is the easiest way to see the front-end in action. The chat will be simulated.</p>
                    <ol class="list-decimal list-inside space-y-4">
                        <li>
                            <strong>Clone the repository:</strong>
                            <div class="code-block p-3 rounded-lg mt-2 text-sm">git clone https://github.com/your-username/streamify.git<br>cd streamify</div>
                        </li>
                        <li>
                            <strong>Open index.html in your browser:</strong>
                            <p class="text-sm mt-1">You can open the <code>index.html</code> file directly. If you see a CORS error with video, run a simple local server:</p>
                            <div class="code-block p-3 rounded-lg mt-2 text-sm">npx serve</div>
                        </li>
                    </ol>
                `,
                'setup-realtime': `
                    <h4 class="font-bold text-lg mb-4">Mode 2: Realtime Chat Mode</h4>
                    <p class="text-[var(--text-secondary)] mb-4">This mode enables the live chat feature by running a small Node.js WebSocket server.</p>
                    <ol class="list-decimal list-inside space-y-4">
                        <li>
                            <strong>Prerequisites:</strong>
                            <p class="text-sm mt-1">You must have Node.js installed on your machine.</p>
                        </li>
                        <li>
                            <strong>Install dependencies:</strong>
                             <div class="code-block p-3 rounded-lg mt-2 text-sm">npm install ws</div>
                        </li>
                        <li>
                            <strong>Start the WebSocket server:</strong>
                             <div class="code-block p-3 rounded-lg mt-2 text-sm">node server.js</div>
                        </li>
                         <li>
                            <strong>Update chat mode in <code>modules/chat.js</code>:</strong>
                             <div class="code-block p-3 rounded-lg mt-2 text-sm">const CHAT_MODE = 'websocket';</div>
                        </li>
                         <li>
                            <strong>Run the front-end via a local server:</strong>
                             <div class="code-block p-3 rounded-lg mt-2 text-sm">npx serve</div>
                        </li>
                    </ol>
                `
            };

            // --- ARCHITECTURE SECTION LOGIC ---
            const archPrinciples = document.getElementById('arch-principles');
            const archDetailsContainer = document.getElementById('arch-details');

            function updateArchDetails(targetId) {
                const data = archData[targetId];
                if (!data) return;
                archDetailsContainer.innerHTML = `<h4 class="font-bold text-lg mb-2">${data.title}</h4><p class="text-[var(--text-secondary)]">${data.content}</p>`;
                
                archPrinciples.querySelectorAll('button').forEach(btn => {
                    btn.classList.remove('bg-[var(--surface)]', 'text-[var(--accent)]');
                    if (btn.dataset.target === targetId) {
                        btn.classList.add('bg-[var(--surface)]', 'text-[var(--accent)]');
                    }
                });
            }

            archPrinciples.addEventListener('click', (e) => {
                const button = e.target.closest('button');
                if (button) {
                    updateArchDetails(button.dataset.target);
                }
            });
            updateArchDetails('arch-vanilla');

            // --- SETUP SECTION LOGIC ---
            const setupTabsContainer = document.querySelector('.flex.border-b');
            const setupContentContainer = document.getElementById('setup-content');

            function updateSetupContent(targetId) {
                setupContentContainer.innerHTML = setupData[targetId];
                document.querySelectorAll('.setup-tab').forEach(tab => {
                    tab.classList.remove('active-tab', 'text-[var(--accent)]');
                    tab.classList.add('text-[var(--text-secondary)]');
                    if (tab.dataset.target === targetId) {
                        tab.classList.add('active-tab');
                        tab.classList.remove('text-[var(--text-secondary)]');
                    }
                });
            }
            
            setupTabsContainer.addEventListener('click', e => {
                if (e.target.classList.contains('setup-tab')) {
                    updateSetupContent(e.target.dataset.target);
                }
            });
            updateSetupContent('setup-mock');
            
            // --- DEMO MODAL LOGIC ---
            const modal = document.getElementById('demo-modal');
            const modalContent = document.getElementById('demo-modal-content');
            const closeModalBtn = document.getElementById('close-modal-btn');
            const demoCards = document.querySelectorAll('.demo-card');

            function openModal() {
                modal.classList.remove('hidden');
                setTimeout(() => {
                    modalContent.classList.remove('scale-95', 'opacity-0');
                    modalContent.classList.add('scale-100', 'opacity-100');
                }, 10);
            }

            function closeModal() {
                modalContent.classList.add('scale-95', 'opacity-0');
                modalContent.classList.remove('scale-100', 'opacity-100');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            }

            demoCards.forEach(card => card.addEventListener('click', openModal));
            closeModalBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    closeModal();
                }
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                    closeModal();
                }
            });
        });
    </script>
</body>
</html>

