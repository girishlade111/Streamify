        <!-- Architecture Section -->
        <section id="architecture" class="py-20">
            <div class="container mx-auto px-6">
                <div class="text-center mb-12 section-intro">
                    <h3 class="text-3xl font-bold">Architecture & Design</h3>
                    <p class="text-md text-[var(--text-secondary)] mt-2">This section makes the technical details from the report more digestible. Interact with the "Core Principles" to learn about the key decisions behind the project's structure. The file tree provides a clear visual of the codebase organization.</p>
                </div>
                <div class="lg:grid lg:grid-cols-3 lg:gap-12">
                    <!-- Principles -->
                    <div class="lg:col-span-1 mb-8 lg:mb-0">
                        <h4 class="font-bold text-lg mb-4">Core Principles</h4>
                        <ul id="arch-principles" class="space-y-2">
                            <li><button data-target="arch-vanilla" class="text-left w-full p-3 rounded-lg font-medium bg-[var(--surface)] text-[var(--accent)]">Vanilla First</button></li>
                            <li><button data-target="arch-modular" class="text-left w-full p-3 rounded-lg font-medium hover:bg-[var(--surface)] transition-colors">Modular JavaScript</button></li>
                            <li><button data-target="arch-state" class="text-left w-full p-3 rounded-lg font-medium hover:bg-[var(--surface)] transition-colors">Simple State Management</button></li>
                            <li><button data-target="arch-css" class="text-left w-full p-3 rounded-lg font-medium hover:bg-[var(--surface)] transition-colors">Modern CSS</button></li>
                            <li><button data-target="arch-data" class="text-left w-full p-3 rounded-lg font-medium hover:bg-[var(--surface)] transition-colors">Data-Driven UI</button></li>
                        </ul>
                    </div>
                    <!-- Details & File Structure -->
                    <div class="lg:col-span-2">
                        <div id="arch-details" class="bg-white p-6 rounded-xl border border-[var(--border-color)] min-h-[250px] mb-8">
                            <!-- JS will populate this -->
                        </div>
                        <h4 class="font-bold text-lg mb-4">Project Structure</h4>
                        <div class="code-block p-4 rounded-lg text-sm overflow-x-auto">
                            <pre>
/
├── 📂 assets/
├── 📂 modules/
│   ├── 📜 api.js
│   ├── 📜 chat.js
│   └── 📜 ...
├── 📜 index.html
├── 📜 channel.html
├── 📜 data.json
└── 📜 server.js (Optional)
                            </pre>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Setup Section -->
        <section id="setup" class="py-20 bg-[var(--surface)]">
            <div class="container mx-auto px-6">
                <div class="text-center mb-12 section-intro">
                    <h3 class="text-3xl font-bold">How to Run</h3>
                    <p class="text-md text-[var(--text-secondary)] mt-2">To improve clarity, the setup instructions from the report are organized into interactive tabs. Select a mode to view the specific steps required to get the project running on your local machine.</p>
                </div>
                <div class="max-w-3xl mx-auto">
                    <!-- Tabs -->
                    <div class="flex border-b border-[var(--border-color)] mb-6">
                        <button class="setup-tab px-6 py-3 font-semibold text-lg" data-target="setup-mock">Mock Mode</button>
                        <button class="setup-tab px-6 py-3 font-semibold text-lg text-[var(--text-secondary)]" data-target="setup-realtime">Realtime Mode</button>
                    </div>
                    <!-- Tab Content -->
                    <div id="setup-content" class="text-left">
                        <!-- JS will populate this -->
                    </div>
                </div>
